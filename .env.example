# Ntelegence Reports — Environment Variables
# Copy to .env for local dev. Set these in Render dashboard for production.

# PostgreSQL connection string (same as TeleTraxx uses on Render)
DATABASE_URL=postgresql://user:password@host/dbname

# Resend API key (same account as TeleTraxx — 49iron@gmail.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# API key to protect the /generate endpoints
# Generate any random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORTS_API_KEY=your_secret_key_here

# Set to 'scheduler' to run cron jobs instead of HTTP server (Render background worker)
# START_MODE=scheduler
